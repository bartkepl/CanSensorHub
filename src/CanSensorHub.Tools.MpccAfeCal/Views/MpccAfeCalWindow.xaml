<Window x:Class="CanSensorHub.Tools.MpccAfeCal.Views.MpccAfeCalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CanSensorHub.Tools.MpccAfeCal.ViewModels"
        xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MpccAfeCalViewModel}"
        Title="Kalibracja wejść napięciowych MPCC" Width="1280" Height="860" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Bg}" Foreground="{DynamicResource Brush.Fg}">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Fg}" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="4,2" />
            <Setter Property="Padding" Value="3,1" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="4,2" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="4,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Fg}" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="4,2" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="4,4,4,0" />
        </Style>
        <Style x:Key="CalStatusCell" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CalibrationRejected}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CheckCell" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CheckPass}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CheckPass}" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="390" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===================== Konfiguracja ===================== -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
                <Border Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1"
                        Padding="8" Margin="0,0,0,8" Visibility="{Binding IsSimulation, Converter={StaticResource BoolToVis}}">
                    <TextBlock TextWrapping="Wrap"
                               Text="Tryb symulatora: przyrządy są symulowane, a symulowany węzeł MPCC ma dzielniki z błędem rzędu 0,5 %. Przebieg jest taki sam jak na stanowisku." />
                </Border>

                <GroupBox Header="Przyrządy">
                    <Grid IsEnabled="{Binding IsSimulation, Converter={StaticResource InverseBool}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Wzorzec (34401A):" />
                        <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Resources}" SelectedItem="{Binding SelectedDmm}" />
                        <TextBlock Grid.Row="1" Text="Zadajnik (34970A):" />
                        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Resources}" SelectedItem="{Binding SelectedDaq}" />
                        <TextBlock Grid.Row="2" Text="Karta 34907A:" />
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="gniazdo" Margin="4,0,0,0" />
                            <ComboBox ItemsSource="{Binding DacSlots}" SelectedItem="{Binding Settings.DacSlot}" Width="70" />
                            <TextBlock Text="DAC" Margin="6,0,0,0" />
                            <ComboBox ItemsSource="{Binding DacOutputs}" SelectedItem="{Binding Settings.DacOutput}" Width="50" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal">
                            <Button Content="Wyszukaj przyrządy" Command="{Binding RefreshResourcesCommand}" />
                            <CheckBox Content="także porty szeregowe" IsChecked="{Binding IncludeSerialPorts}"
                                      ToolTip="Zapytanie *IDN? na porcie innego urządzenia (np. adaptera CAN) zakłóca jego pracę." />
                        </StackPanel>
                        <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Style="{StaticResource Hint}" Text="{Binding InstrumentStatus}" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="Węzeł MPCC">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Odczytaj" Command="{Binding ReadNodeCommand}" />
                            <Button DockPanel.Dock="Right" Content="⟳" ToolTip="Odśwież listę urządzeń" Command="{Binding RefreshDevicesCommand}" />
                            <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <Run Text="{Binding InstanceName, Mode=OneWay}" />
                                            <Run Text="{Binding NodeId, Mode=OneWay, StringFormat='(NODE 0x{0:X2})'}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Hint}" Text="{Binding NodeStatus}" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Zakres i punkty">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Zakres [V]:" />
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                            <TextBox Text="{Binding Settings.MinVoltage}" Width="60" />
                            <TextBlock Text="…" />
                            <TextBox Text="{Binding Settings.MaxVoltage}" Width="60" />
                        </StackPanel>
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Hint}"
                                   Text="Górna granica nie może przekraczać zakresu żadnego dołączonego wejścia. Na kanałach 0–3 napięcie 5 V odpowiada pełnej skali ADC — punkty w nasyceniu są pomijane." />
                        <TextBlock Grid.Row="2" Text="Kalibracja:" />
                        <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Modes}" DisplayMemberPath="Label"
                                  SelectedValuePath="Mode" SelectedValue="{Binding Settings.Mode}" />
                        <TextBlock Grid.Row="3" Text="Punkty kalibracji:" />
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Settings.CalibrationPoints}" Width="60" HorizontalAlignment="Left"
                                 ToolTip="Dotyczy kalibracji wielopunktowej; dwupunktowa używa krańców zakresu." />
                        <TextBlock Grid.Row="4" Text="Punkty sprawdzenia:" />
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Settings.CheckPoints}" Width="60" HorizontalAlignment="Left"
                                 ToolTip="Punkty sprawdzenia leżą między punktami kalibracji." />
                        <TextBlock Grid.Row="5" Text="Kanały:" VerticalAlignment="Top" Margin="0,4,0,0" />
                        <ItemsControl Grid.Row="5" Grid.Column="1" ItemsSource="{Binding ChannelOptions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Label}" IsChecked="{Binding Enabled}" Width="130" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Uśrednianie i stabilność">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Wzorzec — próbki:" />
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                            <TextBox Text="{Binding Settings.DmmSamples}" Width="50" />
                            <TextBlock Text="NPLC" Margin="6,0,0,0" />
                            <ComboBox ItemsSource="{Binding NplcOptions}" SelectedItem="{Binding Settings.DmmNplc}" Width="60" />
                            <CheckBox Content="autozero" IsChecked="{Binding Settings.DmmAutoZero}" />
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="Węzeł — rundy odczytu:" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Settings.NodeRounds}" Width="50" HorizontalAlignment="Left" />
                        <TextBlock Grid.Row="2" Text="Odstęp rund [ms]:" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Settings.NodeRoundIntervalMs}" Width="60" HorizontalAlignment="Left"
                                 ToolTip="0 = okres pomiaru węzła (MEASURE_PERIOD). Krótszy odstęp powtarza tę samą próbkę." />
                        <TextBlock Grid.Row="3" Text="Ustalanie [ms]:" />
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Settings.SettleMs}" Width="60" HorizontalAlignment="Left"
                                 ToolTip="0 = dwa okresy pomiaru węzła + 500 ms." />
                        <TextBlock Grid.Row="4" Text="Maks. σ wzorca [mV]:" />
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Settings.MaxReferenceStdDevMv}" Width="60" HorizontalAlignment="Left" />
                        <TextBlock Grid.Row="5" Text="Maks. prób punktu:" />
                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Settings.MaxAttempts}" Width="60" HorizontalAlignment="Left" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="Akceptacja">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Tolerancja sprawdzenia [mV]:" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Settings.ToleranceMv}" Width="60" HorizontalAlignment="Left" />
                        <TextBlock Grid.Row="1" Text="Maks. korekcja wzmocnienia:" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Settings.MaxGainCorrection}" Width="60" HorizontalAlignment="Left"
                                 ToolTip="Ułamek: 0.05 = 5 %. Większa korekcja wskazuje zwykle błąd połączeń." />
                        <TextBlock Grid.Row="2" Text="Maks. korekcja przesunięcia [mV]:" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Settings.MaxOffsetCorrectionMv}" Width="60" HorizontalAlignment="Left" />
                    </Grid>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- ===================== Przebieg i wyniki ===================== -->
        <DockPanel Grid.Column="2">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                <Button Content="Kalibruj" Command="{Binding CalibrateCommand}" FontWeight="Bold" />
                <Button Content="Tylko sprawdzenie" Command="{Binding CheckCommand}" />
                <Button Content="Stop" Command="{Binding StopCommand}" />
                <ProgressBar Width="220" Height="14" Margin="12,0" Minimum="0" Maximum="1" Value="{Binding Progress}" />
                <TextBlock Text="{Binding StatusText}" />
            </StackPanel>

            <Border DockPanel.Dock="Top" Margin="0,8,0,0" Padding="8" Background="{DynamicResource Brush.Panel}"
                    BorderBrush="{DynamicResource Brush.Warning}" BorderThickness="1"
                    Visibility="{Binding HasPendingCalibration, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Zapisz do węzła i sprawdź" Command="{Binding WriteCommand}" FontWeight="Bold" />
                    <CheckBox IsChecked="{Binding WriteConfirmed}" VerticalContentAlignment="Top">
                        <TextBlock TextWrapping="Wrap"
                                   Text="Zestawienie sprawdzone. Zapisać współczynniki kanałów oznaczonych „do zapisu”. SAVE_CONFIG utrwali całą konfigurację węzła — także niezapisane wcześniej zmiany innych parametrów. Po zapisie blokada CAL_LOCK zostanie założona." />
                    </CheckBox>
                </DockPanel>
            </Border>

            <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                <Button DockPanel.Dock="Right" Content="Folder raportów" Command="{Binding OpenReportFolderCommand}" />
                <TextBlock Text="{Binding LastReportPath, StringFormat='Raport: {0}', TargetNullValue='Raport zapisywany automatycznie po każdej operacji.'}"
                           Opacity="0.7" TextTrimming="CharacterEllipsis" />
            </DockPanel>

            <Grid Margin="0,8,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DataGrid Grid.Row="0" ItemsSource="{Binding Rows}" IsReadOnly="True" HeadersVisibility="Column" Margin="0,0,0,8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Kanał" Binding="{Binding Name}" Width="45" />
                        <DataGridTextColumn Header="c0 obecne [V]" Binding="{Binding C0Before, StringFormat=+0.000000;-0.000000}" Width="88" />
                        <DataGridTextColumn Header="c1 obecne" Binding="{Binding C1Before, StringFormat=0.000000}" Width="72" />
                        <DataGridTextColumn Header="tc" Binding="{Binding Tc, StringFormat=0.00000}" Width="55" />
                        <DataGridTextColumn Header="a" Binding="{Binding Gain, StringFormat=0.000000}" Width="68" />
                        <DataGridTextColumn Header="b [mV]" Binding="{Binding OffsetMv, StringFormat=+0.00;-0.00}" Width="55" />
                        <DataGridTextColumn Header="resid. [mV]" Binding="{Binding MaxResidualMv, StringFormat=0.00}" Width="72" />
                        <DataGridTextColumn Header="c0 nowe [V]" Binding="{Binding C0After, StringFormat=+0.000000;-0.000000}" Width="88" />
                        <DataGridTextColumn Header="c1 nowe" Binding="{Binding C1After, StringFormat=0.000000}" Width="72" />
                        <DataGridTextColumn Header="Kalibracja" Binding="{Binding CalibrationStatus}" Width="*" MinWidth="90" ElementStyle="{StaticResource CalStatusCell}" />
                        <DataGridTextColumn Header="Maks. błąd [mV]" Binding="{Binding CheckMaxErrorMv, StringFormat=0.00}" Width="102" />
                        <DataGridTextColumn Header="Sprawdzenie" Binding="{Binding CheckVerdict}" Width="*" MinWidth="80" ElementStyle="{StaticResource CheckCell}" />
                    </DataGrid.Columns>
                </DataGrid>

                <TabControl Grid.Row="1">
                    <TabItem Header="Wykres błędu">
                        <sp:WpfPlot x:Name="ErrorPlot" />
                    </TabItem>
                    <TabItem Header="Punkty">
                        <DataGrid ItemsSource="{Binding Points}" IsReadOnly="True" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Faza" Binding="{Binding Phase}" Width="90" />
                                <DataGridTextColumn Header="Nr" Binding="{Binding Number}" Width="35" />
                                <DataGridTextColumn Header="Nastawa [V]" Binding="{Binding Setpoint, StringFormat=0.000}" Width="80" />
                                <DataGridTextColumn Header="Wzorzec [V]" Binding="{Binding Reference, StringFormat=0.000000}" Width="85" />
                                <DataGridTextColumn Header="σ wz. [mV]" Binding="{Binding ReferenceSigmaMv, StringFormat=0.000}" Width="70" />
                                <DataGridTextColumn Header="T [°C]" Binding="{Binding Temperature, StringFormat=0.00}" Width="55" />
                                <DataGridTextColumn Header="Próby" Binding="{Binding Attempts}" Width="45" />
                                <DataGridTextColumn Header="CH0 Δ [mV]" Binding="{Binding E0, StringFormat=+0.00;-0.00}" Width="*" />
                                <DataGridTextColumn Header="CH1 Δ [mV]" Binding="{Binding E1, StringFormat=+0.00;-0.00}" Width="*" />
                                <DataGridTextColumn Header="CH2 Δ [mV]" Binding="{Binding E2, StringFormat=+0.00;-0.00}" Width="*" />
                                <DataGridTextColumn Header="CH3 Δ [mV]" Binding="{Binding E3, StringFormat=+0.00;-0.00}" Width="*" />
                                <DataGridTextColumn Header="CH4 Δ [mV]" Binding="{Binding E4, StringFormat=+0.00;-0.00}" Width="*" />
                                <DataGridTextColumn Header="CH5 Δ [mV]" Binding="{Binding E5, StringFormat=+0.00;-0.00}" Width="*" />
                                <DataGridTextColumn Header="CH6 Δ [mV]" Binding="{Binding E6, StringFormat=+0.00;-0.00}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="Dziennik">
                        <ListBox x:Name="LogList" ItemsSource="{Binding Log}" Background="{DynamicResource Brush.Panel}"
                                 Foreground="{DynamicResource Brush.Fg}" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:LogLineVm}">
                                    <TextBlock x:Name="Line" TextWrapping="Wrap">
                                        <Run Text="{Binding Time, Mode=OneWay, StringFormat='HH:mm:ss'}" Foreground="Gray" />
                                        <Run Text="{Binding Text, Mode=OneWay}" />
                                    </TextBlock>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                            <Setter TargetName="Line" Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                            <Setter TargetName="Line" Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>
                </TabControl>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
