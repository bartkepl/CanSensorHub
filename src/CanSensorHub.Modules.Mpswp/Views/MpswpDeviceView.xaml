<UserControl x:Class="CanSensorHub.Modules.Mpswp.Views.MpswpDeviceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CanSensorHub.Modules.Mpswp.ViewModels"
             xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:MpswpDeviceViewModel}"
             Background="{DynamicResource Brush.Bg}">
    <UserControl.Resources>
        <CollectionViewSource x:Key="GroupedParams" Source="{Binding Params}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Descriptor.Group" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="8" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="4,2" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="4,2" />
            <Setter Property="Padding" Value="3,1" />
            <Setter Property="MinWidth" Value="90" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="4,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="4,2" />
            <Setter Property="MinWidth" Value="140" />
        </Style>
        <Style x:Key="ErrFlagCheckBox" TargetType="CheckBox">
            <Setter Property="Margin" Value="4,4" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSet}" Value="True">
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Legend entry: a flat button toggling its curve. The swatch mirrors the plot's line style
             (bold = average, thin with a marker = sensor reading); a hidden curve is dimmed and struck through. -->
        <DataTemplate x:Key="ChartLegendItem" DataType="{x:Type vm:ChartSeriesVm}">
            <Button Command="{Binding ToggleCommand}" Cursor="Hand" Margin="0" Padding="4,2" HorizontalContentAlignment="Left"
                    ToolTip="Kliknij, aby ukryć lub pokazać krzywą"
                    Visibility="{Binding HasData, Converter={StaticResource BoolToVis}}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="3">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Border}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel x:Name="Entry" Orientation="Horizontal">
                    <!-- White backing keeps the black average swatch visible on the dark theme. -->
                    <Border Width="30" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" Background="White" CornerRadius="2">
                        <Grid>
                            <Line x:Name="Swatch" X1="2" X2="28" Y1="7" Y2="7" Stroke="{Binding ColorHex}" StrokeThickness="3" />
                            <Ellipse x:Name="Marker" Width="6" Height="6" Fill="{Binding ColorHex}" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <TextBlock x:Name="Caption" Text="{Binding LegendLabel}" FontSize="11" VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.Fg}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsAverage}" Value="False">
                    <Setter TargetName="Swatch" Property="StrokeThickness" Value="1.5" />
                    <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsChecked}" Value="False">
                    <Setter TargetName="Entry" Property="Opacity" Value="0.4" />
                    <Setter TargetName="Caption" Property="TextDecorations" Value="Strikethrough" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <TabControl Margin="4" Background="Transparent">
        <!-- ===================== Pulpit ===================== -->
        <TabItem Header="Pulpit">
            <DockPanel Margin="8">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Plik CSV:" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBox Text="{Binding CsvPath, UpdateSourceTrigger=PropertyChanged}" Width="360"
                             IsReadOnly="{Binding IsRecordingCsv}" VerticalAlignment="Center" />
                    <Button Content="Przeglądaj..." Command="{Binding BrowseCsvPathCommand}"
                            IsEnabled="{Binding IsRecordingCsv, Converter={StaticResource InverseBool}}" />
                    <Button Content="{Binding RecordButtonLabel}" Command="{Binding ToggleCsvRecordingCommand}" Margin="16,2,4,2" />
                </StackPanel>

                <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.Warning}" Padding="10,6" Margin="0,0,0,8" CornerRadius="4"
                        Visibility="{Binding HasFirmwareCompatWarning, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding FirmwareCompatWarning}" FontWeight="Bold" Foreground="White" TextWrapping="Wrap" />
                </Border>

                <GroupBox DockPanel.Dock="Top" Header="Informacje o urządzeniu (GET_INFO)" Margin="0,0,0,8">
                    <StackPanel>
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Układ identyfikatora:" Opacity="0.7" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ProtocolVersionText}" FontFamily="Consolas" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Firmware:" Opacity="0.7" />
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding FwVersionText}" FontFamily="Consolas" FontWeight="Bold" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Wersja sprzętu (HW):" Opacity="0.7" Margin="0,4,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding HwVersionText}" FontFamily="Consolas" Margin="0,4,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Build #:" Opacity="0.7" Margin="0,4,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding BuildRevisionText}" FontFamily="Consolas" Margin="0,4,0,0" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Flagi builda:" Opacity="0.7" Margin="0,4,0,0" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding BuildFlagsText}" FontFamily="Consolas" Margin="0,4,0,0" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="UID:" Opacity="0.7" Margin="0,4,0,0" />
                            <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding UidText}" FontFamily="Consolas" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Profil protokołu:" Opacity="0.7" Margin="0,4,0,0" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ProfileText}" FontFamily="Consolas" FontWeight="Bold" Margin="0,4,0,0" />
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="Typ urządzenia:" Opacity="0.7" Margin="0,4,0,0" />
                            <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding DeviceTypeText}" FontFamily="Consolas" Margin="0,4,0,0" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Zdolności:" Opacity="0.7" Margin="0,4,0,0" VerticalAlignment="Top" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding CapabilitiesText}" FontFamily="Consolas" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap" />
                        </Grid>
                        <TextBlock Margin="0,8,0,0" Opacity="0.6" FontSize="11" TextWrapping="Wrap"
                                   Text="Węzeł odesłał samą ramkę 4 B (układ identyfikatora, firmware, NODE). Pozostałe pola wysyłają dopiero nowsze generacje firmware: HW/Build#/Flagi/UID — ramka 21 B, profil/typ/zdolności — ramka 28 B."
                                   Visibility="{Binding ShowExtendedInfoNote, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Margin="0,8,0,0" Opacity="0.6" FontSize="11" TextWrapping="Wrap"
                                   Text="Profil, typ urządzenia i zdolności pochodzą z ramki GET_INFO o długości 28 B — węzeł pracuje na starszym profilu i ich nie zgłasza. Pola pozostają puste, ponieważ wartość zero jest poprawnym typem urządzenia i nie da się jej odróżnić od braku danych."
                                   Visibility="{Binding ShowCommonProfileNote, Converter={StaticResource BoolToVis}}" />
                        <Button Content="Odśwież GET_INFO" Command="{Binding RefreshInfoCommand}" Margin="0,8,0,0" HorizontalAlignment="Left" />
                    </StackPanel>
                </GroupBox>

                <ItemsControl ItemsSource="{Binding DashboardTiles}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="1" CornerRadius="4"
                                    Background="{DynamicResource Brush.Panel}" Margin="4" Padding="10" MinWidth="165" MinHeight="96"
                                    ToolTip="{Binding RangeStatusText}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RangeWarn}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Warning}" />
                                                <Setter Property="BorderThickness" Value="2" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RangeErrDropped}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
                                                <Setter Property="BorderThickness" Value="2" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="12" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding DisplayValue}" FontSize="22" FontWeight="Bold" Margin="0,4,0,0"
                                               Foreground="{DynamicResource Brush.Fg}" />
                                    <TextBlock Text="{Binding Unit}" FontSize="12" Opacity="0.6" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding RangeStatusText}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Foreground="{DynamicResource Brush.Warning}"
                                               Visibility="{Binding HasRangeIssue, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </TabItem>

        <!-- ===================== Wykresy ===================== -->
        <TabItem Header="Wykresy">
            <DockPanel Margin="8">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Left" Content="Wyczyść" Command="{Binding ClearChartsCommand}" />
                    <CheckBox DockPanel.Dock="Left" Content="Auto-odpytywanie czujników (po każdej paczce telemetrii)" IsChecked="{Binding AutoPollSensors}" Margin="16,0,0,0" />
                    <TextBlock Text="Gruba czarna = średnia (telemetria), cienka z punktami = odczyt czujnika; każdy czujnik ma ten sam kolor na wszystkich wykresach. Kliknij pozycję legendy, aby ukryć lub pokazać krzywą. Najedź na punkt, aby zobaczyć jego wartość i czas zebrania."
                               VerticalAlignment="Center" Margin="16,0,0,0" Opacity="0.7" TextWrapping="Wrap" />
                </DockPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                            <Button Content="Wszystkie" Command="{Binding SelectAllSensorTracesCommand}" Padding="6,2" FontSize="11" />
                            <Button Content="Żaden" Command="{Binding DeselectAllSensorTracesCommand}" Padding="6,2" FontSize="11" Margin="4,0,0,0" />
                        </StackPanel>
                        <GroupBox Header="Krzywe na wykresie">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding ChartSeriesGroups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,6">
                                                <CheckBox IsChecked="{Binding IsChecked}" Margin="2">
                                                    <TextBlock Text="{Binding Label}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                                </CheckBox>
                                                <ItemsControl ItemsSource="{Binding Series}" Margin="18,0,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox IsChecked="{Binding IsChecked}" Margin="2">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Rectangle Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center"
                                                                               Fill="{Binding ColorHex}" Stroke="White" StrokeThickness="0.5" />
                                                                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                            </CheckBox>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </GroupBox>
                    </DockPanel>
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <GroupBox Header="Temperatura [°C]" Grid.Row="0" Grid.Column="0">
                            <DockPanel>
                                <ScrollViewer DockPanel.Dock="Right" Width="165" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding TempSeries}" ItemTemplate="{StaticResource ChartLegendItem}" />
                                </ScrollViewer>
                                <sp:WpfPlot x:Name="TempPlot" />
                            </DockPanel>
                        </GroupBox>
                        <GroupBox Header="Wilgotność [%RH]" Grid.Row="0" Grid.Column="1">
                            <DockPanel>
                                <ScrollViewer DockPanel.Dock="Right" Width="165" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding HumSeries}" ItemTemplate="{StaticResource ChartLegendItem}" />
                                </ScrollViewer>
                                <sp:WpfPlot x:Name="HumPlot" />
                            </DockPanel>
                        </GroupBox>
                        <GroupBox Header="Ciśnienie [Pa]" Grid.Row="1" Grid.Column="0">
                            <DockPanel>
                                <ScrollViewer DockPanel.Dock="Right" Width="165" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding PressSeries}" ItemTemplate="{StaticResource ChartLegendItem}" />
                                </ScrollViewer>
                                <sp:WpfPlot x:Name="PressPlot" />
                            </DockPanel>
                        </GroupBox>
                        <GroupBox Header="Jakość powietrza [idx]" Grid.Row="1" Grid.Column="1">
                            <DockPanel>
                                <ScrollViewer DockPanel.Dock="Right" Width="165" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding AirSeries}" ItemTemplate="{StaticResource ChartLegendItem}" />
                                </ScrollViewer>
                                <sp:WpfPlot x:Name="AirPlot" />
                            </DockPanel>
                        </GroupBox>
                        <GroupBox Header="Wyładowania AS3935" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,4"
                                           Text="Każdy punkt = jedno wykryte wyładowanie. Oś pozioma: czas, oś pionowa: odległość [km] zgłoszona przez czujnik. Kolor: siła wyładowania (rejestr AS3935 bez stałej jednostki fizycznej) podzielona na trzy grupy względem ostatnich zdarzeń — niebieski = najsłabsze, pomarańczowy = średnie, czerwony = najsilniejsze." />
                                <sp:WpfPlot x:Name="LightningPlot" />
                            </DockPanel>
                        </GroupBox>
                    </Grid>
                </Grid>
            </DockPanel>
        </TabItem>

        <!-- ===================== Parametry ===================== -->
        <TabItem Header="Parametry">
            <DockPanel Margin="8">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="Odczytaj wszystkie" Command="{Binding ReadAllParamsCommand}" />
                    <Button Content="Zapisz do NVM (Flash)" Command="{Binding SaveConfigCommand}" />
                    <Button Content="Przywróć domyślne" Command="{Binding LoadDefaultsCommand}" />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Source={StaticResource GroupedParams}}">
                        <ItemsControl.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Margin="0,10,0,4"
                                                   Foreground="{DynamicResource Brush.Accent}" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ItemsControl.GroupStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,6">
                                    <Grid ToolTip="{Binding Description}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" FontFamily="Consolas" />

                                        <CheckBox Grid.Column="1" Visibility="{Binding IsCheckbox, Converter={StaticResource BoolToVis}}"
                                                  IsChecked="{Binding BoolValue}" IsEnabled="{Binding IsReadOnly, Converter={StaticResource InverseBool}}" />
                                        <ComboBox Grid.Column="1" Visibility="{Binding IsCombo, Converter={StaticResource BoolToVis}}"
                                                  ItemsSource="{Binding Options}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                                  SelectedValue="{Binding ComboValue}" IsEnabled="{Binding IsReadOnly, Converter={StaticResource InverseBool}}" />
                                        <TextBox Grid.Column="1" Visibility="{Binding IsHex, Converter={StaticResource BoolToVis}}"
                                                 Text="{Binding HexText, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}" />
                                        <TextBox Grid.Column="1" Visibility="{Binding IsPlainNumeric, Converter={StaticResource BoolToVis}}"
                                                 Text="{Binding NumericText, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}" />

                                        <TextBlock Grid.Column="2" Text="{Binding Unit}" VerticalAlignment="Center" Opacity="0.7" />
                                        <Button Grid.Column="3" Content="Zapisz" Command="{Binding WriteCommand}" IsEnabled="{Binding IsReadOnly, Converter={StaticResource InverseBool}}" />
                                        <TextBlock Grid.Column="4" Text="{Binding Description}" VerticalAlignment="Center" Opacity="0.6"
                                                   TextTrimming="CharacterEllipsis" Margin="8,0,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </TabItem>

        <!-- ===================== Czujniki ===================== -->
        <TabItem Header="Czujniki">
            <DockPanel Margin="8">
                <StackPanel DockPanel.Dock="Top">
                    <GroupBox Header="Antena AS3935">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Kalibruj antenę AS3935" Command="{Binding CalibrateAntennaCommand}"
                                    IsEnabled="{Binding IsCalibratingAntenna, Converter={StaticResource InverseBool}}" />
                            <TextBlock Text="{Binding AntennaStatusText}" VerticalAlignment="Center" Margin="12,0" FontWeight="Bold" />
                        </StackPanel>
                    </GroupBox>
                    <Button Content="Odśwież wszystkie" Command="{Binding RefreshAllSensorsCommand}" HorizontalAlignment="Left" Margin="4,4,0,8" />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Sensors}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="1" CornerRadius="4"
                                        Background="{DynamicResource Brush.Panel}" Margin="4" Padding="10" Width="230"
                                        ToolTip="Odczyty poza zakresem: ⚠ = ostrzeżenie (poza LPL/UPL, nadal uśredniane), ✗ = odrzucone (poza LTL/UTL czujnika)">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasRangeWarning}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Warning}" />
                                                    <Setter Property="BorderThickness" Value="2" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HasRangeError}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
                                                    <Setter Property="BorderThickness" Value="2" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center"
                                                     Fill="{Binding IsPresent, Converter={StaticResource ConnectionDotConverter}}" />
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Status}" Opacity="0.7" Margin="0,4,0,0" />
                                        <StackPanel Margin="0,4,0,0" MinHeight="32">
                                            <TextBlock Text="—" Opacity="0.6"
                                                       Visibility="{Binding HasNoReadings, Converter={StaticResource BoolToVis}}" />
                                            <ItemsControl ItemsSource="{Binding Readings}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <!-- Stacked vertically, not horizontally: a horizontal StackPanel measures
                                                             children with infinite available width, so TextWrapping never actually
                                                             wraps there — long "zakres: lo–hi" text just overflows the card's fixed
                                                             width and gets clipped mid-number. Stacking top-to-bottom constrains each
                                                             TextBlock to the card's real width, so both lines wrap properly. -->
                                                        <StackPanel Margin="0,0,0,2">
                                                            <TextBlock Text="{Binding ValueText}" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding LimitText}" Opacity="0.55" FontSize="11" TextWrapping="Wrap"
                                                                       Visibility="{Binding HasLimitText, Converter={StaticResource BoolToVis}}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        <Button Content="Odczytaj" Command="{Binding ReadCommand}" Margin="0,8,0,0" HorizontalAlignment="Left"
                                                IsEnabled="{Binding IsReading, Converter={StaticResource InverseBool}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </TabItem>

        <!-- ===================== Status ===================== -->
        <TabItem Header="Status">
            <StackPanel Margin="8">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="Odśwież" Command="{Binding RefreshStatusCommand}" />
                    <Button Content="Reset urządzenia" Command="{Binding ResetDeviceCommand}" />
                    <TextBlock Text="{Binding HealthySensorCount, StringFormat='Sprawne czujniki: {0}'}" VerticalAlignment="Center" Margin="16,0,0,0" FontWeight="Bold" />
                </StackPanel>
                <Border Background="{DynamicResource Brush.Danger}" Padding="10,6" Margin="0,0,0,8" CornerRadius="4"
                        Visibility="{Binding IsCritical, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="KRYTYCZNY BŁĄD!" FontWeight="Bold" Foreground="White" FontSize="14" />
                </Border>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <GroupBox Header="Podsystemy (SYS) — zielony = sprawny" Grid.Column="0">
                        <ItemsControl ItemsSource="{Binding SysFlagIndicators}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSet, Mode=OneWay}"
                                              IsHitTestVisible="False" ToolTip="{Binding Description}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </GroupBox>
                    <GroupBox Header="Błędy (ERR) — zaznaczone = problem" Grid.Column="1">
                        <ItemsControl ItemsSource="{Binding ErrFlagIndicators}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSet, Mode=OneWay}" IsHitTestVisible="False"
                                              ToolTip="{Binding Description}" Style="{StaticResource ErrFlagCheckBox}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </GroupBox>
                </Grid>
            </StackPanel>
        </TabItem>

        <!-- ===================== Czas ===================== -->
        <TabItem Header="Czas">
            <StackPanel Margin="8">
                <GroupBox Header="Zegar RTC (MCP79410)">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Odczytaj" Command="{Binding ReadTimeCommand}" />
                        <TextBlock Text="{Binding DeviceTimeText}" VerticalAlignment="Center" Margin="12,0" FontFamily="Consolas" FontSize="14" />
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Ustawienie czasu">
                    <StackPanel>
                        <Button Content="Ustaw z zegara PC" Command="{Binding SetTimeFromPcCommand}" HorizontalAlignment="Left" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <DatePicker SelectedDate="{Binding ManualTime}" />
                            <Button Content="Ustaw ręcznie" Command="{Binding SetTimeManualCommand}" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </TabItem>

        <!-- ===================== Zdarzenia ===================== -->
        <TabItem Header="Zdarzenia">
            <DataGrid ItemsSource="{Binding EventLog}" AutoGenerateColumns="False" IsReadOnly="True" Margin="8">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Czas" Binding="{Binding Timestamp, StringFormat='HH:mm:ss.fff'}" Width="110" />
                    <DataGridTextColumn Header="Źródło" Binding="{Binding Source}" Width="120" />
                    <DataGridTextColumn Header="Kod" Binding="{Binding Code}" Width="140" />
                    <DataGridTextColumn Header="Opis" Binding="{Binding Description}" Width="240" />
                    <DataGridTextColumn Header="Dane" Binding="{Binding DataHex}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </TabItem>
    </TabControl>
</UserControl>
