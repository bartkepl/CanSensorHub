<Window x:Class="CanSensorHub.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CanSensorHub.App"
        xmlns:vm="clr-namespace:CanSensorHub.App.ViewModels"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        mc:Ignorable="d"
        Title="CanSensorHub — centrum obsługi czujników CAN" Height="800" Width="1300"
        Background="{DynamicResource Brush.Bg}">
    <Window.Resources>
        <Style TargetType="Button" x:Key="ToolbarButton">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="4,0" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ===================== Connection toolbar ===================== -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <!-- Grupy paska zawijają się do kolejnego wiersza, gdy okno jest za wąskie. Teksty stanu i błędu
                 mają zmienną długość, więc mają ograniczoną szerokość — w jednym poziomym StackPanelu
                 wypychały przyciski akcji poza okno. -->
            <WrapPanel Margin="8,6">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,16,2">
                    <TextBlock Text="Połączenie:" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <ComboBox ItemsSource="{Binding TransportKinds}" DisplayMemberPath="Label" SelectedValuePath="Key"
                              SelectedValue="{Binding SelectedTransportKind}" Width="230" Margin="0,0,10,0"
                              IsEnabled="{Binding IsConnected, Converter={StaticResource InverseBool}}" />

                    <TextBlock Text="Port:" VerticalAlignment="Center" Margin="0,0,4,0"
                               Visibility="{Binding IsSlcanMode, Converter={StaticResource BoolToVis}}" />
                    <ComboBox ItemsSource="{Binding AvailablePorts}" SelectedItem="{Binding SelectedPort}" Width="90" Margin="0,0,4,0"
                              Visibility="{Binding IsSlcanMode, Converter={StaticResource BoolToVis}}"
                              IsEnabled="{Binding IsConnected, Converter={StaticResource InverseBool}}" />
                    <Button Content="⟳" ToolTip="Odśwież listę portów COM" Command="{Binding RefreshPortsCommand}" Style="{StaticResource ToolbarButton}"
                            Visibility="{Binding IsSlcanMode, Converter={StaticResource BoolToVis}}" />

                    <TextBlock Text="Bitrate:" VerticalAlignment="Center" Margin="10,0,4,0"
                               Visibility="{Binding IsSlcanMode, Converter={StaticResource BoolToVis}}" />
                    <ComboBox ItemsSource="{Binding AvailableBitrates}" SelectedItem="{Binding SelectedBitrate}" Width="90" Margin="0,0,10,0"
                              Visibility="{Binding IsSlcanMode, Converter={StaticResource BoolToVis}}"
                              IsEnabled="{Binding IsConnected, Converter={StaticResource InverseBool}}" />

                    <Button Content="Połącz" Command="{Binding ConnectCommand}" Style="{StaticResource ToolbarButton}" />
                    <Button Content="Rozłącz" Command="{Binding DisconnectCommand}" Style="{StaticResource ToolbarButton}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,16,2">
                    <Ellipse Width="10" Height="10" Margin="0,0,4,0" VerticalAlignment="Center"
                             Fill="{Binding IsConnected, Converter={StaticResource ConnectionDotConverter}}" />
                    <TextBlock Text="{Binding ConnectionStatusText}" VerticalAlignment="Center" FontWeight="Bold" MaxWidth="340"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding ConnectionStatusText}" />
                    <TextBlock Text="{Binding LastError}" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource Brush.Danger}"
                               MaxWidth="360" TextTrimming="CharacterEllipsis" ToolTip="{Binding LastError}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2">
                    <Button Content="+ Dodaj urządzenie..." Command="{Binding AddDeviceCommand}" Margin="0,0,0,0" Padding="10,4"
                            IsEnabled="{Binding IsConnected}" />
                    <Button Content="Bootloader..." Click="OnOpenBootloaderTool" Margin="8,0,0,0" Padding="10,4" />
                    <!-- Narzędzia serwisowe z zestawów CanSensorHub.Tools.*; przycisk znika, gdy build ich nie zawiera. -->
                    <Button x:Name="ToolsButton" Content="Narzędzia ▾" Click="OnOpenToolsMenu" Margin="8,0,0,0" Padding="10,4"
                            Visibility="{Binding HasTools, Converter={StaticResource BoolToVis}}">
                        <Button.ContextMenu>
                            <ContextMenu ItemsSource="{Binding Tools}">
                                <ContextMenu.ItemContainerStyle>
                                    <Style TargetType="MenuItem">
                                        <Setter Property="Header" Value="{Binding DisplayName}" />
                                        <Setter Property="ToolTip" Value="{Binding Description}" />
                                        <EventSetter Event="Click" Handler="OnToolMenuItemClick" />
                                    </Style>
                                </ContextMenu.ItemContainerStyle>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- ===================== Tabs: pinned "Monitor magistrali" (index 0, not closable) + device tabs =====================
             A plain DataType-keyed implicit DataTemplate would be picked for BOTH the tab header and the tab
             body for the same item, so header vs. content need their own TypeSwitchTemplateSelector (see
             TypeSwitchTemplateSelector.cs) rather than just dropping DataTemplates into TabControl.Resources. -->
        <TabControl ItemsSource="{Binding TabItems}" SelectedItem="{Binding SelectedTabItem}" Margin="4">
            <TabControl.ItemTemplateSelector>
                <local:TypeSwitchTemplateSelector>
                    <local:TypeSwitchTemplateSelector.BusMonitorTemplate>
                        <!-- Pinned Bus Monitor tab header: no online-dot, no close button, always first (TabItems keeps it at index 0). -->
                        <DataTemplate DataType="{x:Type vm:BusMonitorViewModel}">
                            <TextBlock Text="Monitor magistrali CAN" VerticalAlignment="Center" FontWeight="Bold" />
                        </DataTemplate>
                    </local:TypeSwitchTemplateSelector.BusMonitorTemplate>
                    <local:TypeSwitchTemplateSelector.DeviceTemplate>
                        <DataTemplate DataType="{x:Type vm:DeviceEntry}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center"
                                         Fill="{Binding Instance.IsOnline, Converter={StaticResource ConnectionDotConverter}}" />
                                <TextBlock Text="{Binding Instance.HeaderText}" VerticalAlignment="Center" />
                                <Button Content="✕" Width="18" Height="18" Margin="8,0,0,0" Padding="0" FontSize="10"
                                        ToolTip="Usuń urządzenie"
                                        Command="{Binding DataContext.RemoveDeviceCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </local:TypeSwitchTemplateSelector.DeviceTemplate>
                </local:TypeSwitchTemplateSelector>
            </TabControl.ItemTemplateSelector>

            <TabControl.ContentTemplateSelector>
                <local:TypeSwitchTemplateSelector>
                    <local:TypeSwitchTemplateSelector.BusMonitorTemplate>
                        <DataTemplate DataType="{x:Type vm:BusMonitorViewModel}">
                            <!-- ===================== Bus monitor (global, module-agnostic raw CAN log) ===================== -->
                            <DockPanel Margin="4">
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                                    <Button Content="Wstrzymaj/Wznów" Command="{Binding TogglePauseCommand}" Padding="8,2" Margin="2,0" />
                                    <Button Content="Wyczyść" Command="{Binding ClearCommand}" Padding="8,2" Margin="2,0" />
                                    <Button Content="Eksportuj CSV..." Command="{Binding ExportCommand}" Padding="8,2" Margin="2,0" />
                                    <TextBlock Text="Filtr:" VerticalAlignment="Center" Margin="16,0,4,0" />
                                    <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" Width="160" />
                                    <TextBlock Text="{Binding TotalCount, StringFormat='Odebrano/wysłano: {0}'}" VerticalAlignment="Center" Margin="16,0,0,0" Opacity="0.7" />
                                    <TextBlock Text="WSTRZYMANO" VerticalAlignment="Center" Margin="16,0,0,0" FontWeight="Bold"
                                               Foreground="{DynamicResource Brush.Danger}" Visibility="{Binding IsPaused, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                                <DataGrid ItemsSource="{Binding EntriesView}" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Czas" Binding="{Binding Timestamp, StringFormat='HH:mm:ss.fff'}" Width="110" />
                                        <DataGridTextColumn Header="Kier." Binding="{Binding Direction}" Width="50" />
                                        <DataGridTextColumn Header="ID (hex)" Binding="{Binding Frame.Id, StringFormat='0x{0:X8}'}" Width="90" />
                                        <DataGridTextColumn Header="FUNC" Binding="{Binding FuncName}" Width="90" />
                                        <DataGridTextColumn Header="NODE" Binding="{Binding Id.Node, StringFormat='0x{0:X2}'}" Width="60" />
                                        <DataGridTextColumn Header="OBJ" Binding="{Binding Id.Obj, StringFormat='0x{0:X2}'}" Width="60" />
                                        <DataGridTextColumn Header="ARG" Binding="{Binding Id.Arg, StringFormat='0x{0:X2}'}" Width="60" />
                                        <DataGridTextColumn Header="DLC" Binding="{Binding Frame.Data.Length}" Width="40" />
                                        <DataGridTextColumn Header="Dane (hex)" Binding="{Binding DataHex}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </DataTemplate>
                    </local:TypeSwitchTemplateSelector.BusMonitorTemplate>
                    <local:TypeSwitchTemplateSelector.DeviceTemplate>
                        <DataTemplate DataType="{x:Type vm:DeviceEntry}">
                            <ContentControl Content="{Binding Instance.View}" />
                        </DataTemplate>
                    </local:TypeSwitchTemplateSelector.DeviceTemplate>
                </local:TypeSwitchTemplateSelector>
            </TabControl.ContentTemplateSelector>
        </TabControl>
    </DockPanel>
</Window>
